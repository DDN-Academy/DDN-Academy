# ===================================================================================================
# GoldPilot — modèle du fichier de configuration de PRODUCTION (deploy/.env)
# ===================================================================================================
# Mode d'emploi (détaillé dans docs/05_deploiement_et_exploitation.md) :
#   1. sur le serveur :  cd goldpilot/deploy && cp .env.example .env && chmod 600 .env
#   2. remplir les valeurs marquées OBLIGATOIRE ;
#   3. ne JAMAIS envoyer ce fichier .env dans Git, par e-mail ou par messagerie (il contient tes secrets).
#
# Génération des secrets (après « docker compose build », sur le serveur) :
#   valeur aléatoire  : docker compose run --rm --no-deps migrate python -m goldpilot.cli secret
#   mot de passe site : docker compose run --rm --no-deps migrate python -m goldpilot.cli hash-password
#                       (le mot de passe est demandé deux fois sans s'afficher ; seul son hachage est imprimé)
#   vérification      : docker compose run --rm --no-deps migrate python -m goldpilot.cli check
#
# Règles d'écriture : une variable par ligne, NOM=valeur, sans espace autour du « = ».
# Le hachage du mot de passe contient des « $ » : l'écrire entre apostrophes simples, comme dans l'exemple.
#
# Trois environnements séparés (cahier des charges § 15) :
#   - développement : ton ordinateur, base SQLite, DATA_SOURCE=replay (rejeu de l'historique), http://localhost ;
#   - test          : tests automatiques (pytest), base SQLite temporaire créée puis détruite par chaque test ;
#   - production    : ce fichier ; PostgreSQL, HTTPS, rejeu INTERDIT. Au démarrage, GoldPilot refuse de
#                     fonctionner si la configuration est dangereuse (secret trop court, http://, SQLite, rejeu…).
# ===================================================================================================


# ---------------------------------------------------------------------------------------------------
# A. Serveur, nom de domaine et HTTPS (lus par docker-compose.yml)
# ---------------------------------------------------------------------------------------------------

# OBLIGATOIRE. Nom de domaine du site, SANS https:// ni « / » final. Il doit pointer vers l'adresse IPv4
# du serveur (enregistrement DNS de type A). TradingView n'envoie pas de webhooks en IPv6.
# Sert à : certificat HTTPS (Caddy) et PUBLIC_BASE_URL (calculée automatiquement : https://<domaine>).
GOLDPILOT_DOMAIN=goldpilot.exemple.fr

# OBLIGATOIRE. Adresse e-mail transmise à Let's Encrypt lors de la création du compte de certificats
# (avis éventuels concernant le certificat). Ce n'est pas un identifiant de connexion.
ACME_EMAIL=ton.adresse@exemple.fr

# OBLIGATOIRE. Mot de passe de la base PostgreSQL (utilisé uniquement entre les conteneurs ; la base
# n'est jamais exposée sur Internet). Générer avec « python -m goldpilot.cli secret » (lettres, chiffres,
# « - » et « _ » seulement : pas de caractère qui poserait problème dans une URL).
# ATTENTION : PostgreSQL ne lit cette valeur qu'à la création de la base. Pour la changer ensuite,
# suivre la procédure de rotation de docs/05 (sinon la connexion échoue).
POSTGRES_PASSWORD=

# Facultatif. Nombre de jours de conservation des sauvegardes quotidiennes (défaut : 14).
BACKUP_RETENTION_DAYS=14

# Facultatif. Intervalle entre deux sauvegardes automatiques, en heures (défaut : 24).
BACKUP_INTERVAL_HOURS=24

# Facultatif. 1 = inclure la bibliothèque Databento dans l'image (nécessaire seulement si
# DATA_SOURCE=databento ; reconstruire l'image après changement : docker compose build). Défaut : 0.
WITH_DATABENTO=0

# Facultatif. Étiquette de l'image Docker construite localement (défaut : latest).
GOLDPILOT_TAG=latest


# ---------------------------------------------------------------------------------------------------
# B. Accès au site (lus par le backend, goldpilot/backend/goldpilot/config.py)
# ---------------------------------------------------------------------------------------------------

# OBLIGATOIRE en production. Hachage scrypt de ton mot de passe de connexion au site (12 caractères
# minimum). Le mot de passe lui-même n'est stocké nulle part. Générer avec :
#   docker compose run --rm --no-deps migrate python -m goldpilot.cli hash-password
# Format attendu : scrypt$...$...  — à écrire ENTRE APOSTROPHES SIMPLES (le texte contient des « $ »).
ADMIN_PASSWORD_HASH='scrypt$REMPLACER$PAR_LE_RESULTAT_DE_HASH_PASSWORD'

# OBLIGATOIRE en production (au moins 32 caractères aléatoires). Générer avec « python -m goldpilot.cli secret ».
# Note honnête : dans la version actuelle du code, cette valeur est exigée au démarrage mais n'est utilisée
# par aucune fonction (les sessions sont des jetons aléatoires dont seule l'empreinte est stockée en base).
# Elle est réservée à un usage futur ; la changer n'a aujourd'hui aucun effet sur les connexions.
SECRET_KEY=

# Facultatif. Durée d'une session de connexion au site, en heures (défaut : 12).
SESSION_HOURS=12


# ---------------------------------------------------------------------------------------------------
# C. Données de marché
# ---------------------------------------------------------------------------------------------------

# Source des prix (défaut : tradingview).
#   tradingview : barres envoyées par ton script Pine « GoldPilot Bridge » (webhook) — choix prévu ;
#   databento   : flux Databento (abonnement payant, voir docs/01 ; exige WITH_DATABENTO=1) ;
#   replay      : rejeu de l'historique, réservé au développement — REFUSÉ en production.
DATA_SOURCE=tradingview

# OBLIGATOIRE si DATA_SOURCE=tradingview (au moins 24 caractères aléatoires). Jeton secret que le script
# Pine place dans chaque message ; tout message sans le bon jeton est rejeté. Générer avec
# « python -m goldpilot.cli secret », puis copier la MÊME valeur dans les paramètres du script Pine sur
# TradingView (voir la page « Réglages » du site).
TV_WEBHOOK_TOKEN=

# Facultatif (défaut : true). true = n'accepter les webhooks que depuis les adresses IP officielles de
# TradingView. À laisser à true en production.
TV_ENFORCE_IP=true

# Facultatif. Liste des adresses IP autorisées pour les webhooks, séparées par des virgules. Laisser VIDE
# pour utiliser la liste officielle intégrée au code (52.89.214.238, 34.212.75.30, 54.218.53.128,
# 52.32.178.7, relevée sur la documentation TradingView — voir docs/01). À ne remplir que si TradingView
# publie une nouvelle liste.
TV_IP_ALLOWLIST=

# Uniquement si DATA_SOURCE=databento. Clé API Databento (compte payant, voir docs/01). Sinon laisser vide.
DATABENTO_API_KEY=


# ---------------------------------------------------------------------------------------------------
# D. Notifications Telegram (facultatives mais recommandées ; sans elles, aucune alerte téléphone)
# ---------------------------------------------------------------------------------------------------

# Jeton du bot fourni par @BotFather dans Telegram (format 123456789:AA...). Secret.
TELEGRAM_BOT_TOKEN=

# Identifiant de ta conversation avec le bot (un nombre). Après avoir envoyé un message à ton bot, le
# bouton « Détecter » de la page Réglages du site l'affiche ; le recopier ici puis redémarrer.
TELEGRAM_CHAT_ID=


# ---------------------------------------------------------------------------------------------------
# E. Contexte et calendrier
# ---------------------------------------------------------------------------------------------------

# Facultatif. Clé API gratuite FRED (Federal Reserve Bank of St. Louis), pour l'affichage du contexte
# macroéconomique (taux, dollar) sur une page secondaire. Information de contexte uniquement : sans
# effet sur les signaux. Sans clé, ce contexte est simplement affiché comme indisponible.
FRED_API_KEY=

# Facultatif. Intervalle de rafraîchissement du calendrier économique officiel, en minutes (défaut : 360).
CALENDAR_REFRESH_MIN=360


# ---------------------------------------------------------------------------------------------------
# F. Journaux
# ---------------------------------------------------------------------------------------------------

# Facultatif. Niveau de détail des journaux du MOTEUR : DEBUG, INFO, WARNING, ERROR (défaut du code : INFO).
# WARNING recommandé pour l'instant : constaté le 10/10/2026, au niveau INFO la bibliothèque httpx écrit
# l'adresse complète de chaque requête, et l'adresse des requêtes Telegram contient le jeton du bot.
# Ne passer à INFO qu'après avoir vérifié (docker compose logs engine) que ce jeton n'apparaît plus.
LOG_LEVEL=WARNING


# ---------------------------------------------------------------------------------------------------
# G. Variables FIXÉES par docker-compose.yml — inutile de les écrire ici (elles seraient remplacées)
# ---------------------------------------------------------------------------------------------------
# APP_ENV=production             environnement : development (défaut du code) | test | production
# DATABASE_URL=postgresql+psycopg://goldpilot:<POSTGRES_PASSWORD>@postgres:5432/goldpilot
#                                construite à partir de POSTGRES_PASSWORD ; en développement, défaut du code :
#                                sqlite:///<goldpilot>/var/goldpilot.db. Le préfixe « postgresql+psycopg:// »
#                                est obligatoire (pilote psycopg 3 installé dans l'image).
# PUBLIC_BASE_URL=https://<GOLDPILOT_DOMAIN>
#                                adresse publique du site, utilisée pour afficher l'URL du webhook à copier
#                                dans TradingView ; doit commencer par https:// en production
#                                (défaut du code : http://localhost:8000).
# TRUST_PROXY=true               le site est derrière Caddy : l'adresse IP du visiteur est lue dans
#                                X-Forwarded-For (que Caddy remplace). Défaut du code : false. Ne JAMAIS mettre
#                                true si le service web est exposé directement sur Internet.
#
# Fixées dans l'image Docker (Dockerfile) :
# FRONTEND_DIR=/app/frontend/dist  dossier du site compilé (défaut du code : <goldpilot>/frontend/dist)
# RESEARCH_DIR=/app/research/output dossier des résultats de recherche lus par le site et le moteur,
#                                dont final/production.json (défaut du code : <goldpilot>/research/output)
#
# Développement uniquement (sans effet en production, où le rejeu est refusé) :
# REPLAY_SPEED=120               vitesse du rejeu (0 = aussi vite que possible ; défaut 120)
# REPLAY_FROM=2025-06-02         date de début du rejeu (défaut 2025-06-02)
