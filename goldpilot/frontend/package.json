{
  "name": "goldpilot-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Site GoldPilot (React + TypeScript + Vite), compilé en fichiers statiques servis par le backend FastAPI.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "captures": "CAPTURES=1 playwright test --project=mobile e2e/captures.spec.ts"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.8.3",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  }
}
