# ── Supabase ──────────────────────────────────────────────────────────────
# Dashboard Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Clé service_role — SERVEUR UNIQUEMENT (webhook Stripe). Jamais exposée au client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Stripe ────────────────────────────────────────────────────────────────
# Dashboard Stripe > Developers > API keys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Price ID du plan Pro mensuel (Dashboard Stripe > Products)
STRIPE_PRICE_ID_PRO=price_...
# Secret du webhook (Dashboard Stripe > Developers > Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_...

# ── App ───────────────────────────────────────────────────────────────────
# URL publique de l'app (utilisée pour les redirections Stripe/OAuth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
